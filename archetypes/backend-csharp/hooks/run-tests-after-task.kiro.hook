{
  "enabled": true,
  "name": "Executar Testes Após Task",
  "version": "1",
  "description": "Executa os testes automaticamente após a conclusão de uma task de spec, garantindo que as mudanças não quebraram nada.",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "dotnet test --no-build"
  }
}
