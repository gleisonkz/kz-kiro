{
  "enabled": true,
  "name": "Type Check After Write",
  "version": "1",
  "description": "Executa verificação de tipos TypeScript após o agente escrever ou editar arquivos.",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Valide os arquivos alterados com o comando `npx tsc --noEmit --pretty`"
  },
  "workspaceFolderName": "mb-monorepo-frontend",
  "shortName": "typecheck-on-save"
}