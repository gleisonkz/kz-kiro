{
  "enabled": true,
  "name": "Type Check After Write",
  "version": "2",
  "description": "Executa verificação de tipos TypeScript após o agente parar, apenas se houve escrita em arquivos .ts/.tsx dentro de src/ nesta sessão.",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Verifique se nesta sessão houve criação ou edição de arquivos `.ts` ou `.tsx` dentro de `src/`. Se NÃO houve, não faça nada e não comente.\n\nSe HOUVE, execute o comando `npx tsc --noEmit --pretty` e reporte apenas se houver erros de tipo."
  },
  "workspaceFolderName": "mb-monorepo-frontend",
  "shortName": "typecheck-on-save"
}