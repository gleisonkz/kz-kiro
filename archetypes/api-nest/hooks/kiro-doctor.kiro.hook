{
  "name": "Kiro Doctor",
  "version": "1.0.0",
  "description": "Verifica a saúde do projeto: build, lint e testes",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Execute os seguintes comandos em sequência e reporte os resultados: 1) npm run build 2) npm run lint 3) npm test. Se algum falhar, analise o erro e sugira correções."
  }
}
